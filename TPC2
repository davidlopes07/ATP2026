solução = 67
tentativas = 0
palpite = int(input("Adivinha o número (entre 0 a 100): "))
tentativas = tentativas + 1
while palpite != solução:
    if palpite < solução:
        print("O número que pensei é Maior")
    elif palpite > solução:
        print("O número que pensei é Menor")
    palpite = int(input("Tenta outra vez!: "))
    tentativas = tentativas + 1
print("Acertou!")
print("Descobriste em", tentativas)
